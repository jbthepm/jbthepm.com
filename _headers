# Cloudflare Pages custom headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Images are stable, so cache them hard - but NOT "immutable" for a year. These
# filenames are not content-hashed, and a request to a path before the file
# exists gets its 404 cached under this same rule. A week is fast and
# recoverable; a year means a broken asset stays broken until a manual purge.
/assets/*
  Cache-Control: public, max-age=604800

# NOTE on styles.css / main.js: Pages pins them to max-age=14400 and will not
# let this file lower it. Tested and confirmed: a directory wildcard like
# /assets/* is honoured, but an exact path (/styles.css) and an extension glob
# (/*.css) are both ignored. Cache-busting is therefore done with the ?v=N query
# string on the tags in index.html - bump it whenever either file changes.

# HTML should always revalidate so edits go live immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Let AI crawlers and tools read these from anywhere.
/llms.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
