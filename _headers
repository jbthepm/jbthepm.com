# Cloudflare Pages custom headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Hashed/static assets can be cached hard. Bump filenames when they change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# NOTE: Cloudflare Pages ignores Cache-Control set here for static assets - it
# pins them to max-age=14400 regardless. Everything else in this file does
# apply. Cache-busting for styles.css and main.js is done with a ?v= query
# string on the tags in index.html instead - bump it whenever either changes.

# HTML should always revalidate so edits go live immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Let AI crawlers and tools read these from anywhere.
/llms.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
