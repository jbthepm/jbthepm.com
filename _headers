# Cloudflare Pages custom headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Images are stable, so cache them hard - but NOT "immutable" for a year. These
# filenames are not content-hashed, and a request to a path before the file
# exists gets its 404 cached under this same rule. A week is fast and
# recoverable; a year means a broken asset stays broken until a manual purge.
/assets/*
  Cache-Control: public, max-age=604800

# styles.css and main.js are not content-hashed, so they must revalidate.
# Without this they sit in the browser cache for hours and pair new HTML with a
# stale stylesheet. index.html also appends a ?v= to both as a second line of
# defence - bump it whenever either file changes.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/main.js
  Cache-Control: public, max-age=0, must-revalidate

# HTML should always revalidate so edits go live immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Let AI crawlers and tools read these from anywhere.
/llms.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
